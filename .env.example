# ── Flask ────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-random-string
JWT_SECRET_KEY=change-me-to-another-random-string

# ── Admin account ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@devnotes.local

# ── Database (chọn 1 trong 3, hoặc bỏ trống để dùng SQLite) ──
#
# SQLite (mặc định — không cần khai báo gì):
# → DB lưu tại ./data/devnotes.db
#
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/devnotes
#
# MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/devnotes
#
# MongoDB:
# MONGO_URI=mongodb://user:password@localhost:27017/devnotes?authSource=admin
# MONGO_DB=devnotes

# ── Telegram Bot (tuỳ chọn — bỏ trống nếu không dùng) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# ── App ──────────────────────────────────────────
APP_NAME=DevNotes
OTP_EXPIRE_MINUTES=10
