# ── Flask ─────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# ── Admin user (tạo tự động lần đầu chạy) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@devnotes.local

# ── Database (bỏ trống = dùng SQLite mặc định) ────────────────────
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=devnotes
# DATABASE_URL=postgresql://user:pass@localhost/devnotes
# DATABASE_URL=mysql://user:pass@localhost/devnotes

# ── Multi-user mode ────────────────────────────────────────────────
# OWNER_MODE=single   # tất cả dùng chung 1 pool (mặc định)
# OWNER_MODE=multi    # mỗi user thấy data riêng

# ── Image storage ─────────────────────────────────────────────────
# Ảnh lưu dưới dạng base64 trong DB (không dùng file system)
IMAGE_MAX_MB=5         # Giới hạn dung lượng ảnh upload (MB)
IMAGE_QUALITY=85       # Chất lượng nén WebP phía JS (0–100)

# ── Telegram Bot ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
APP_NAME=DevNotes

# ── OTP ───────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ── Rate limiter storage (mặc định = memory, production dùng Redis)
# RATELIMIT_STORAGE_URI=redis://localhost:6379
